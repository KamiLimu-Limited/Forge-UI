# Forge Frontend — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local or any other file holding real values.

# Base URL of the Forge API, with no trailing slash. Next.js bakes it into the
# client bundle at build time, so `next build` fails if it is missing.
#
# Local Forge API (~/forge-api, uvicorn forge.main:app --reload):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Shared dev API:
#   NEXT_PUBLIC_API_BASE_URL=https://dev.api.kamilimu.org
#
# Vercel does not read this file. It takes the value from the project settings:
# Settings > Environment Variables, for Production and Preview. Redeploy after
# changing it.
#
# Never put database details or secrets in a NEXT_PUBLIC_ variable: those
# values end up in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
