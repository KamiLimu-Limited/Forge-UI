# =============================================================================
# Forge Frontend: .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/

# Next.js build output
.next/
.next-verify/
out/
build/
dist/
next-env.d.ts

# Vercel CLI (vercel link / vercel pull)
.vercel/

# Storybook build
storybook-static/

# Playwright (screenshots, reports and local browser cache)
screenshots/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment variables: never commit these. .env.example is the only one tracked.
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# Tool caches
.cache/
.eslintcache
.swc/
.turbo/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# Testing
coverage/
.nyc_output/

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor (shared VS Code settings stay tracked)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI tools: local state only. CLAUDE.md, AGENTS.md and the shared rule files stay tracked.
.aider*
!.aider.conf.yml
.claude/settings.local.json

# Misc
*.pem
*.local
